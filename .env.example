# Entry Accounting — орчны хувьсагчид. Хуулж .env.local болгоно (git-д орохгүй).

# ── Заавал ──────────────────────────────────────────────────────────────────
# PostgreSQL (Railway/Neon/локал). drizzle-kit push + runtime хоёулаа ашиглана.
DATABASE_URL=postgresql://user:password@localhost:5432/entry

# NextAuth JWT нууц — `openssl rand -base64 32`
AUTH_SECRET=change-me

# Гадаад хаяг (OAuth metadata, нэхэмжлэхийн линк, MCP URL). Production-д заавал.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Сонголтоор ──────────────────────────────────────────────────────────────
# AI туслах — хэрэглэгч бүр Тохиргоо → AI туслах хэсэгт өөрийн түлхүүрээ
# шифрлэж хадгалж болно; эдгээр нь серверийн default (fallback).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Нэхэмжлэх имэйлээр илгээх (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM="Entry <invoice@example.mn>"

# Бүртгэлийг зориуд НЭЭЛТТЭЙ болгох (нийтийн демо г.м.). Default нь:
# эхний хэрэглэгч чөлөөтэй, дараа нь зөвхөн урилгын линкээр (lib/registration.ts)
# ENTRY_OPEN_REGISTRATION=1

# Deploy-ийн commit SHA — Railway/Vercel автоматаар өгдөг; өөр орчинд гараар.
# GIT_SHA=

# custom/packages/demo — журнал батлагдах бүрд POST хийх webhook (integration жишээ)
# CUSTOM_WEBHOOK_URL=https://hooks.example.com/entry
