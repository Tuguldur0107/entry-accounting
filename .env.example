# Entry Accounting — орчны хувьсагчид. Хуулж .env.local болгоно (git-д орохгүй).

# ── Заавал ──────────────────────────────────────────────────────────────────
# PostgreSQL (Railway/Neon/локал). drizzle-kit push + runtime хоёулаа ашиглана.
DATABASE_URL=postgresql://user:password@localhost:5432/entry

# NextAuth JWT нууц — `openssl rand -base64 32`
AUTH_SECRET=change-me

# Гадаад хаяг (OAuth metadata, нэхэмжлэхийн линк, MCP URL). Production-д заавал.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Сонголтоор ──────────────────────────────────────────────────────────────
# Баримт таних AI (АР/АП: eBarimt / PDF / зураг → нэхэмжлэхийн ноорог) —
# Entry-ийн өөрийн Anthropic түлхүүр. Байхгүй бол тэр товч 503 буцаана.
# AI чат апп дотор БАЙХГҮЙ — хэрэглэгч өөрийн ChatGPT / Claude-оос MCP-ээр (/ai).
# ANTHROPIC_API_KEY=sk-ant-...

# Нэхэмжлэх имэйлээр илгээх (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM="Entry <invoice@example.mn>"

# Бүртгэлийг зориуд НЭЭЛТТЭЙ болгох (нийтийн демо г.м.). Default нь:
# эхний хэрэглэгч чөлөөтэй, дараа нь зөвхөн урилгын линкээр (lib/registration.ts)
# ENTRY_OPEN_REGISTRATION=1

# Deploy-ийн commit SHA — Railway/Vercel автоматаар өгдөг; өөр орчинд гараар.
# GIT_SHA=

# custom/packages/demo — журнал батлагдах бүрд POST хийх webhook (integration жишээ)
# CUSTOM_WEBHOOK_URL=https://hooks.example.com/entry

# Мэдэгдлийн хуваарьт ажил (docs/notifications/00-proposal.md §4.2):
# default нь in-process ticker (тохиргоо шаардахгүй). Гадны cron-оор
# POST /api/cron/notifications дуудах бол нууц үг — байхгүй бол зам 503.
# CRON_SECRET=
# In-process ticker-ийг унтраах (зөвхөн гадны cron ашиглах бол)
# NOTIFICATIONS_TICKER=off
# eBarimt: ТЕГ-ийн нийтийн лавлах (getTinInfo/getInfo/getBranchInfo) ЗӨВХӨН Монголын
# IP-ээс хандагддаг — гадаад бүсийн серверт Монголд байрлах прокси/операторын хаяг
# (ижил замууд). Хоосон бол https://api.ebarimt.mn/api/info/check
# EBARIMT_PUBLIC_API_BASE=
# Telegram суваг — @BotFather-аас авсан token (webhook шаардахгүй; хэрэглэгч
# Тохиргоо → Мэдэгдлийн тохиргоо хэсгээс bot-той чатаа холбоно)
# TELEGRAM_BOT_TOKEN=

# Багцын онлайн төлбөр (SaaS) — Entry-ийн ӨӨРИЙН QPay мерчант (docs/billing §6a)
# ENTRY_BILLING_QPAY_API_KEY=qpd_live_...
# ENTRY_BILLING_QPAY_WEBHOOK_SECRET=...
# ENTRY_BILLING_QPAY_API_URL=https://qpay-dashboard-production.up.railway.app
